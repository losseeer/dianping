# Java 后端地址
JAVA_API_BASE_URL=http://localhost:8081

# Redis 配置（与 Java 后端共享同一实例）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# LLM 配置
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o-mini

# Agent1 服务端口
AGENT1_PORT=8001

# Agent1 缓存 TTL（秒）
AGENT1_CACHE_TTL=1800
