# Java 后端地址
JAVA_API_BASE_URL=http://localhost:8081

# MySQL 配置（长期记忆持久化，与 Java 后端共享同一实例）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=290390
MYSQL_DATABASE=dingping

# Redis 配置（缓存层）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# LLM 配置
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o-mini

# Agent1 端口（Agent2 调用 Agent1 API 时需要）
AGENT1_PORT=8001

# Agent2 服务端口
AGENT2_PORT=8002

# Agent2 HITL 阈值
AGENT2_MAX_CANDIDATES_FOOD=20
AGENT2_MAX_CANDIDATES_OTHER=10
AGENT2_MIN_CANDIDATES=3
AGENT2_MAX_ITERATIONS=3

# Agent2 记忆配置
MEMORY_KEY_PREFIX=user:
MEMORY_EXPIRY_DAYS=90

# 短期记忆：会话级上下文（MySQL 持久化 + Redis 缓存）
CONVERSATION_KEY_PREFIX=agent2:conversation:
CONVERSATION_MAX_TURNS=30

# Layer 3: Trajectory Store
TRAJECTORY_KEY_PREFIX=agent2:trajectory:
TRAJECTORY_EXPIRY_DAYS=30
TRAJECTORY_MAX_RECENT=100

# Layer 2: Playbook (ACE) — MySQL 持久化 + Redis 缓存 + Chroma 向量检索
PLAYBOOK_KEY=agent2:playbook
PLAYBOOK_MAX_ENTRIES=200
# Token 限制（防止 prompt 膨胀 / 成本爆炸）
TOKEN_CHARS_PER_TOKEN=2
TOKEN_MAX_PER_REQUEST=30000
TOKEN_MAX_CANDIDATES_IN_PROMPT=10
TOKEN_MAX_REVIEW_SUMMARY_CHARS=300
TOKEN_MAX_CONVERSATION_CHARS=1500
PLAYBOOK_REFLECTION_THRESHOLD=6.0

# Layer 4: Self-Improvement
SELF_IMPROVE_MIN_TRAJECTORIES=5
SELF_IMPROVE_HELD_OUT_RATIO=0.3

# Benchmark
EVAL_KEY_PREFIX=agent2:eval:
