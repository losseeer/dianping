# ── 环境配置（仅部署相关，业务常量见 config.py）──

# Java 后端地址
JAVA_API_BASE_URL=http://localhost:8081

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-password
MYSQL_DATABASE=dingping

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# LLM
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o-mini

# Agent 端口
AGENT1_PORT=8001
AGENT2_PORT=8002

# Agent2 工作流日志
# 默认写入 agent-services/agent2/log/
AGENT2_LOG_DIR=./log
AGENT2_LOG_LEVEL=INFO
# 默认截断长 payload；设为 true 才记录完整请求/模型内容
AGENT2_LOG_FULL_PAYLOADS=false
AGENT2_LOG_MAX_PAYLOAD_CHARS=4000
